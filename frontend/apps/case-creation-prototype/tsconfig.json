{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["react", "react-dom"],
    "paths": {
      "@/api/*": ["../../api/*"],
      "@/utils/*": ["../../utils/*"],
      "@/components/*": ["../../components/*"],
      "@/base/*": ["../../components/base/*"],
      "@/lib/*": ["../../components/lib/*"],
      "@/hooks/*": ["../../components/hooks/*"],
      "@/themes/*": ["../../themes/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
